{
  "expo": {
    "name": "طلباتي SD",
    "slug": "talabati-sd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tawsel-icon.png",
    "scheme": "tawsel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/tawsel-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B1F4D"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "supportsRtl": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.talabatisd.app"
    },
    "web": {
      "favicon": "./assets/images/tawsel-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-location",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "39789b8a-bf79-4683-a7bd-296e58b80e29"
      }
    }
  }
}
